def cmd_deploy(args):
    """Deploy or upgrade CYRIS production stack."""
    print("================================================================")
    print("  CYRIS v2 — Production System Deployment")
    print("================================================================\n")

    # 1. Validate configuration
    print("[1/5] Verifying production configuration...")
    try:
        res = run_command([sys.executable, sys.argv[0], "config", "check"])
    except subprocess.CalledProcessError:
        print(f"{COLOR_RED}Error:{COLOR_RESET} Configuration check failed. Fix errors in {CYRIS_ENV_FILE} before deploying.")
        sys.exit(1)
    print("  ✓ Configuration verified.")

    # 2. Pull container images
    print("\n[2/5] Pulling target production container images...")
    docker_compose_cmd("pull", capture=False, check=False)

    # 3. Start infrastructure services first
    print("\n[3/5] Starting core infrastructure (PostgreSQL, Redis, Typesense, MinIO)...")
    docker_compose_cmd("up", "-d", "postgres", "redis", "typesense", "minio", "minio-init", capture=False)

    print("  Waiting for infrastructure readiness...")
    for _ in range(30):
        res = docker_compose_cmd("ps", "--format", "json", check=False)
        if res.returncode == 0 and res.stdout:
            lines = res.stdout.strip().split("\n")
            healthy_count = 0
            for line in lines:
                try:
                    c = json.loads(line)
                    name = c.get("Service", "")
                    health = c.get("Health", "")
                    if name in ("postgres", "redis", "typesense", "minio") and health == "healthy":
                        healthy_count += 1
                except Exception:
                    pass
            if healthy_count >= 4:
                break
        time.sleep(2)

    # 4. Apply database migrations
    print("\n[4/5] Applying database migrations...")
    mig_res = docker_compose_cmd("run", "--rm", "-T", "api", "node", "dist/scripts/db-migrate.js", capture=False, check=False)
    if mig_res.returncode != 0:
        print(f"{COLOR_RED}Deployment aborted:{COLOR_RESET} Database migrations failed.")
        sys.exit(1)

    # Search schema initialization if necessary
    print("  Initializing search engine schema...")
    docker_compose_cmd("run", "--rm", "-T", "api", "node", "dist/scripts/search-setup.js", check=False)

    # 5. Start application services
    print("\n[5/5] Starting CYRIS API, Worker, and Web...")
    docker_compose_cmd("up", "-d", "api", "worker", "web", capture=False)

    print("\n  Waiting for application readiness...")
    env = load_env()
    http_port = env.get("CYRIS_HTTP_PORT", "3000")
    for _ in range(30):
        try:
            req = urllib.request.urlopen("http://127.0.0.1:4000/health", timeout=2)
            if req.status == 200:
                break
        except Exception:
            pass
        time.sleep(2)

    print("\n================================================================")
    print(f"  {COLOR_GREEN}✓ CYRIS v2 deployed and operational!{COLOR_RESET}")
    print(f"  Web Interface: {env.get('PUBLIC_WEB_URL', f'http://localhost:{http_port}')}")
    print("  To verify system health: sudo cyrisctl doctor --full")
    print("================================================================\n")


