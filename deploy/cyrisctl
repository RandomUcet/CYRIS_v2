def get_github_headers() -> dict:
    """Prepare HTTP headers with optional GitHub authentication."""
    headers = {"User-Agent": "cyrisctl", "Accept": "application/vnd.github.v3+json"}
    env = load_env()
    token = os.environ.get("GITHUB_TOKEN") or env.get("GITHUB_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return headers


def update_env_version(version: str):
    """Persist updated CYRIS_VERSION into /etc/cyris/cyris.env."""
    if not os.path.exists(CYRIS_ENV_FILE):
        return
    try:
        with open(CYRIS_ENV_FILE, "r", encoding="utf-8") as f:
            content = f.read()
        if re.search(r"^CYRIS_VERSION=.*$", content, flags=re.MULTILINE):
            new_content = re.sub(r"^CYRIS_VERSION=.*$", f"CYRIS_VERSION={version}", content, flags=re.MULTILINE)
        else:
            new_content = content + f"\nCYRIS_VERSION={version}\n"
        with open(CYRIS_ENV_FILE, "w", encoding="utf-8") as f:
            f.write(new_content)
        os.chmod(CYRIS_ENV_FILE, 0o600)
    except Exception as e:
        print(f"Warning: Could not update {CYRIS_ENV_FILE}: {e}")


def update_manifest_version(version: str):
    """Persist updated version into /opt/cyris/release-manifest.json."""
    manifest_data = {}
    if os.path.exists(CYRIS_MANIFEST_FILE):
        try:
            with open(CYRIS_MANIFEST_FILE, "r", encoding="utf-8") as f:
                manifest_data = json.load(f)
        except Exception:
            manifest_data = {}
    manifest_data["version"] = version
    manifest_data["releaseDate"] = datetime.now(timezone.utc).isoformat()
    manifest_data["images"] = {
        "api": f"ghcr.io/randomucet/cyris-api:{version}",
        "worker": f"ghcr.io/randomucet/cyris-worker:{version}",
        "web": f"ghcr.io/randomucet/cyris-web:{version}",
    }
    try:
        with open(CYRIS_MANIFEST_FILE, "w", encoding="utf-8") as f:
            json.dump(manifest_data, f, indent=2)
    except Exception as e:
        print(f"Warning: Could not update {CYRIS_MANIFEST_FILE}: {e}")


