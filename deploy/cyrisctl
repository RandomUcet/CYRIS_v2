# Full snapshots for Ubuntu's bind-mounted production stack. The recovery key stays outside the archive.
SNAP_EXT = ".tar.gz.gpg"
def snapshot_layout():
    return {
        "env": Path(CYRIS_ENV_FILE), "compose": Path(CYRIS_COMPOSE_FILE), "release": Path(CYRIS_MANIFEST_FILE),
        **{k: Path(CYRIS_VAR, k) for k in ("postgres", "redis", "typesense", "minio", "caddy")},
        "web-config": Path(CYRIS_OPT, "Caddyfile"), "web-ca": Path(CYRIS_OPT, "CYRIS-root.crt"),
        "ldap-ca": Path(CYRIS_ETC, "api-ca"), "first-server": Path(CYRIS_ETC, "first-server"),
        "first-server-complete": Path(CYRIS_ETC, "first-server-complete"),
    }


def require_layout(names):
    required = {"env", "compose", "release", "postgres", "redis", "typesense", "minio"}
    if not required.issubset(names):
        raise ValueError("Missing snapshot components: " + ", ".join(sorted(required - set(names))))


def crypt_archive(source, target, decrypt=False):
    key = Path(CYRIS_ETC, "backup.key")
    if not key.exists() and not decrypt:
        with os.fdopen(os.open(key, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            f.write(secrets.token_hex(32) + "\n")
    if not key.is_file() or key.is_symlink() or key.stat().st_mode & 0o077 or key.stat().st_size < 32:
        raise ValueError(f"Missing or insecure recovery key at {key} (expected mode 0600)")
    subprocess.run(["gpg", "--batch", "--no-autostart", "--s2k-count", "65011712", "--no-symkey-cache", "--pinentry-mode", "loopback",
                    "--passphrase-file", str(key), "--compress-algo", "none", "--output", str(target),
                    *(["--decrypt"] if decrypt else ["--symmetric", "--cipher-algo", "AES256"]), str(source)], check=True)


def safe_member(info):
    if not (info.isfile() or info.isdir()):
        raise ValueError(f"Unsupported snapshot entry: {info.name}")
    return info


def add_snapshot_path(archive, path, name):
    # Hard-linked regular files can occur in index checkpoints. Archive their contents;
    # external symlinks would refer to data outside the recovery set.
    if path.is_symlink():
        raise ValueError(f"External link requires a separate recovery plan: {path}")
    def normalize(member):
        safe_member(member)
        member.mode &= 0o777
        return member
    archive.add(path, arcname=name, recursive=False, filter=normalize)
    if path.is_dir():
        for child in sorted(path.iterdir()):
            add_snapshot_path(archive, child, name + "/" + child.name)


def snapshot_inventory(archive):
    names = set()
    roots = set()
    allowed = snapshot_layout()
    directory_roots = {"postgres", "redis", "typesense", "minio", "caddy", "ldap-ca"}
    directories = set()
    for info in archive:
        safe_member(info)
        parts = info.name.split("/")
        if parts[0] not in allowed or any(p in ("", ".", "..") for p in parts) or info.name in names:
            raise ValueError(f"Unexpected snapshot path: {info.name}")
        if (len(parts) == 1 and info.isdir() != (parts[0] in directory_roots)) or (len(parts) > 1 and "/".join(parts[:-1]) not in directories):
            raise ValueError(f"Invalid snapshot hierarchy: {info.name}")
        if info.mode & 0o7000:
            raise ValueError(f"Unexpected special permissions: {info.name}")
        if info.isdir():
            directories.add(info.name)
        names.add(info.name)
        if len(parts) == 1:
            roots.add(parts[0])
    require_layout(roots)
    return sorted(roots)


def running_services():
    return docker_compose_cmd("ps", "--status", "running", "--services").stdout.split()


def cmd_backup(args):
    """Create an encrypted, consistent snapshot, reviving exactly the services that were running."""
    dest = Path(CYRIS_BACKUPS)
    dest.mkdir(mode=0o700, parents=True, exist_ok=True)
    version = get_installed_version()
    if not re.fullmatch(r"[a-zA-Z0-9.-]+", version):
        raise ValueError("Invalid installed version")
    prefix = "backup_auto_" if getattr(args, "backup_action", None) == "scheduled" else "backup_"
    target = dest / (prefix + datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ_v") + version + SNAP_EXT)
    paths = {k: p for k, p in snapshot_layout().items() if p.exists()}
    require_layout(paths)
    if not shutil.which("gpg"):
        raise ValueError("Install gpg on the Ubuntu server before creating a backup.")
    services = running_services()
    with tempfile.TemporaryDirectory(dir=dest) as temp:
        raw = Path(temp, "snapshot.tar.gz")
        sealed = Path(temp, "snapshot.gpg")
        print("Saving database, objects, queues, index, TLS and configuration. Pausing services.", flush=True)
        try:
            if services:
                docker_compose_cmd("stop", *services, capture=False)
            with tarfile.open(raw, "w:gz", compresslevel=1, dereference=True) as tar:
                for name, p in paths.items():
                    add_snapshot_path(tar, p, name)
        finally:
            if services:
                docker_compose_cmd("start", "--wait", "--wait-timeout", "240", *services, capture=False)
        with tarfile.open(raw, "r:gz") as archive:
            snapshot_inventory(archive)
        crypt_archive(raw, sealed)
        os.chmod(sealed, 0o600)
        os.replace(sealed, target)
    print(f"Encrypted backup: {target}\nStore /etc/cyris/backup.key separately in your recovery vault.")
    return target


def backup_target(value=None):
    dest = Path(CYRIS_BACKUPS)
    if value:
        return dest / value
    candidates = list(dest.glob("backup_*.tar.gz*"))
    files = [p for p in candidates if p.name.endswith((SNAP_EXT, ".tar.gz"))]
    if not files:
        raise ValueError("No backups found")
    return max(files, key=lambda p: p.stat().st_mtime_ns)


def cmd_backup_verify(args):
    target = backup_target(args.backup)
    if not target.name.endswith(SNAP_EXT):
        args.backup = str(target)
        return verify_legacy_backup(args)
    with tempfile.TemporaryDirectory(dir=CYRIS_BACKUPS) as temp:
        raw = Path(temp, "verified.tar.gz")
        crypt_archive(target, raw, decrypt=True)
        with tarfile.open(raw, "r:gz") as tar:
            roots = snapshot_inventory(tar)
    print("Integrity and snapshot contents verified: " + ", ".join(roots))


def cmd_restore(args):
    target = backup_target(args.backup)
    if not target.name.endswith(SNAP_EXT):
        return restore_legacy(args, target)
    paths = snapshot_layout()
    with tempfile.TemporaryDirectory(dir=CYRIS_BACKUPS) as temp, ExitStack() as stages:
        raw = Path(temp, "verified.tar.gz")
        crypt_archive(target, raw, decrypt=True)
        staged = {}
        recovery_complete = True
        with tarfile.open(raw, "r:gz") as tar:
            roots = snapshot_inventory(tar)
            for root in roots:
                if paths[root].is_mount() or paths[root].is_symlink():
                    raise ValueError(f"Cannot atomically replace mount point or link: {paths[root]}")
                directory = Path(tempfile.mkdtemp(prefix=".cyris-restore-", dir=paths[root].parent))
                stages.callback(lambda path=directory: shutil.rmtree(path) if recovery_complete else print(f"Recovery files retained at {path}", file=sys.stderr))
                staged[root] = directory
            # Only regular files and directories with checked relative names can reach extraction.
            for root, directory in staged.items():
                members = [m for m in tar.getmembers() if m.name.split("/", 1)[0] == root]
                tar.extractall(directory, members=members, numeric_owner=True, filter="fully_trusted")
        if not args.force and input(f"Replace CYRIS data and configuration from {target.name}? [y/N] ").lower() != "y":
            return
        services = running_services()
        exchanged = []
        try:
            if services:
                docker_compose_cmd("stop", *services, capture=False)
            for root, directory in staged.items():
                live = paths[root]
                previous = directory / "previous"
                if live.exists():
                    os.replace(live, previous)
                exchanged.append(root)
                os.replace(directory / root, live)
            if services:
                docker_compose_cmd("up", "-d", "--force-recreate", "--no-deps", "--wait", "--wait-timeout", "240", *services, capture=False)
        except BaseException:
            recovery_complete = False
            if exchanged and services:
                docker_compose_cmd("stop", *services, capture=False)
            for root in reversed(exchanged):
                previous = staged[root] / "previous"
                if paths[root].exists():
                    os.replace(paths[root], staged[root] / "failed")
                if previous.exists():
                    os.replace(previous, paths[root])
            if services:
                docker_compose_cmd("up", "-d", "--no-deps", "--force-recreate", "--wait", *services, capture=False)
            recovery_complete = True
            raise
    print("Snapshot restored.")


def restore_legacy(args, target):
    """Old releases saved one SQL database and optionally the physical storage bucket."""
    verify_legacy_backup(argparse.Namespace(backup=str(target)))
    with tempfile.TemporaryDirectory(dir=CYRIS_BACKUPS) as temp, tarfile.open(target) as archive:
        names = set()
        for member in archive:
            safe_member(member)
            parts = member.name.split("/")
            if any(p in ("", ".", "..") for p in parts) or member.name in names:
                raise ValueError("Unsafe legacy archive")
            names.add(member.name)
        archive.extractall(temp, filter="data")
        dumps = list(Path(temp).glob("*/database.sql"))
        if len(dumps) != 1 or not dumps[0].stat().st_size:
            raise ValueError("Expected one database dump")
        bucket = dumps[0].parent / "s3/cyris-storage"
        print("Legacy backup: SQL" + (" and storage bucket" if bucket.is_dir() else " only"))
        if not args.force and input("Replace these components? [y/N] ").lower() != "y":
            return
        services = running_services()
        writers = [s for s in APP_SERVICES if s in services]
        if "postgres" not in services:
            raise ValueError("Start PostgreSQL before restoring a legacy SQL archive")
        if writers:
            docker_compose_cmd("stop", *writers, capture=False)
        try:
            recovery = cmd_backup(args)
            cmd_backup_verify(argparse.Namespace(backup=str(recovery)))
        except BaseException:
            if writers:
                docker_compose_cmd("start", *writers, capture=False)
            raise
        print(f"Pre-restore snapshot: {recovery}", flush=True)
        env = load_env()
        cmd = ["docker", "compose", "--env-file", CYRIS_ENV_FILE, "-f", CYRIS_COMPOSE_FILE, "exec", "-T",
               "postgres", "psql", "-X", "-v", "ON_ERROR_STOP=1", "--single-transaction",
               "-U", env.get("POSTGRES_USER", "cyris"), "-d", env.get("POSTGRES_DB", "cyris"),
               "-c", "DROP SCHEMA IF EXISTS drizzle CASCADE; DROP SCHEMA public CASCADE; CREATE SCHEMA public;", "-f", "-"]
        with dumps[0].open("rb") as stream:
            subprocess.run(cmd, stdin=stream, check=True)
        if bucket.is_dir():
            live = Path(CYRIS_VAR, "minio", "cyris-storage")
            if "minio" in services:
                docker_compose_cmd("stop", "minio", capture=False)
            with tempfile.TemporaryDirectory(dir=Path(CYRIS_VAR)) as directory:
                new = Path(directory, "new")
                shutil.copytree(bucket, new)
                if live.exists():
                    os.replace(live, Path(directory, "previous"))
                os.replace(new, live)
            if "minio" in services:
                docker_compose_cmd("start", "minio", capture=False)
        if writers:
            docker_compose_cmd("start", *writers, capture=False)
    print("Legacy components restored.")


def verify_legacy_backup(args):
    """Verify integrity of a backup archive."""
    target = args.backup
    if not target:
        # Find newest backup
        backups = [f for f in os.listdir(CYRIS_BACKUPS) if f.startswith("backup_") and f.endswith(".tar.gz")]
        if not backups:
            print(f"{COLOR_RED}Error:{COLOR_RESET} No backup archives found in {CYRIS_BACKUPS}")
            sys.exit(1)
        backups.sort(reverse=True)
        target = os.path.join(CYRIS_BACKUPS, backups[0])

    if not os.path.isabs(target):
        target = os.path.join(CYRIS_BACKUPS, target)

    print(f"Verifying backup archive: {target}")

    if not os.path.exists(target):
        print(f"{COLOR_RED}Error:{COLOR_RESET} Backup file not found: {target}")
        sys.exit(1)

    # Check sha256 checksum if .sha256 file exists
    sha_file = f"{target}.sha256"
    if os.path.exists(sha_file):
        with open(sha_file) as f:
            expected_hash = f.read().split()[0]
        h = hashlib.sha256()
        with open(target, "rb") as f:
            while chunk := f.read(8192):
                h.update(chunk)
        actual_hash = h.hexdigest()
        if actual_hash != expected_hash:
            print(f"{COLOR_RED}Checksum verification failed!{COLOR_RESET}")
            print(f"  Expected: {expected_hash}")
            print(f"  Actual:   {actual_hash}")
            sys.exit(1)
        print("  ✓ SHA-256 checksum verified.")

    # Inspect tarball contents
    tar_list = run_command(["tar", "-tf", target]).stdout.strip().split("\n")
    has_manifest = any("manifest.json" in line for line in tar_list)
    has_db = any("database.sql" in line for line in tar_list)

    if not has_manifest:
        print(f"{COLOR_RED}Integrity failure:{COLOR_RESET} manifest.json missing from archive.")
        sys.exit(1)
    if not has_db:
        print(f"{COLOR_RED}Integrity failure:{COLOR_RESET} database.sql missing from archive.")
        sys.exit(1)

    print("  ✓ Archive contains manifest.json and database.sql.")
    print(f"{COLOR_GREEN}✓ Backup verification SUCCESSFUL!{COLOR_RESET}")


def cmd_backups(args):
    """List available backups."""
    if not os.path.exists(CYRIS_BACKUPS):
        print(f"No backups directory found at {CYRIS_BACKUPS}")
        return

    for archive in sorted(Path(CYRIS_BACKUPS).glob("backup_*"), reverse=True):
        if archive.name.endswith((SNAP_EXT, ".tar.gz")):
            kind = "encrypted snapshot" if archive.name.endswith(SNAP_EXT) else "legacy SQL archive"
            print(f"{archive.name}   {archive.stat().st_size // 1024} KiB   {kind}")


