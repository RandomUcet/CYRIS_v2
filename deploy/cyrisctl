def cmd_backup(args):
    """Create authoritative backup of PostgreSQL, MinIO, and configuration."""
    print("================================================================")
    print("  CYRIS v2 — Disaster Recovery & Backup")
    print("================================================================\n")

    os.makedirs(CYRIS_BACKUPS, mode=0o700, exist_ok=True)

    timestamp = datetime.now().strftime("%Y-%m-%dT%H-%M-%S")
    version = get_installed_version()
    backup_id = f"backup_{timestamp}_v{version}"
    backup_dir = os.path.join(CYRIS_BACKUPS, backup_id)
    os.makedirs(backup_dir, mode=0o700, exist_ok=True)

    print(f"[1/4] Created backup target: {backup_dir}")

    # 1. PostgreSQL Dump
    print("[2/4] Dumping PostgreSQL database...")
    sql_file = os.path.join(backup_dir, "database.sql")
    with open(sql_file, "w", encoding="utf-8") as f:
        res = docker_compose_cmd("exec", "-T", "postgres", "pg_dump", "-U", "cyris", "cyris", capture=True, check=False)
        if res.returncode != 0 or not res.stdout:
            print(f"{COLOR_RED}Error:{COLOR_RESET} PostgreSQL database dump failed.")
            sys.exit(1)
        f.write(res.stdout)

    sql_size_kb = os.path.getsize(sql_file) / 1024
    print(f"  ✓ Database dump created ({sql_size_kb:.1f} KB)")

    # 2. MinIO S3 Object Mirror
    print("[3/4] Mirroring MinIO S3 object storage...")
    s3_dir = os.path.join(backup_dir, "s3")
    os.makedirs(s3_dir, mode=0o700, exist_ok=True)

    # Use minio-init mc to mirror buckets into mounted /data or via docker cp
    docker_compose_cmd(
        "exec", "-T", "minio-init",
        f"/bin/sh -c \"/usr/bin/mc mirror cyris/cyris-storage /data/cyris-storage-backup 2>/dev/null || true\"",
        check=False
    )
    # Copy from persistent storage path /var/lib/cyris/minio
    minio_storage = os.path.join(CYRIS_VAR, "minio", "cyris-storage")
    if os.path.exists(minio_storage):
        shutil.copytree(minio_storage, os.path.join(s3_dir, "cyris-storage"), dirs_exist_ok=True)
    print("  ✓ S3 object storage mirrored.")

    # 3. Release Manifest & Configuration Snapshot
    print("[4/4] Writing cryptographic manifest & configuration metadata...")
    if os.path.exists(CYRIS_MANIFEST_FILE):
        shutil.copy2(CYRIS_MANIFEST_FILE, os.path.join(backup_dir, "release-manifest.json"))

    # Sanitize config (do not include plaintext master key or passwords in manifest)
    manifest = {
        "backupId": backup_id,
        "timestamp": datetime.now().isoformat(),
        "cyrisVersion": version,
        "components": {
            "postgres": {
                "file": "database.sql",
                "sizeBytes": os.path.getsize(sql_file),
            },
            "s3": {
                "directory": "s3",
            },
            "search": {
                "rebuildable": True,
                "rebuildScript": "cyrisctl search reindex",
            },
            "redis": {
                "transient": True,
                "note": "Redis cache and rate limits regenerate automatically upon restart.",
            },
        },
        "security": {
            "plaintextSecretsIncluded": False,
            "masterKeyIncluded": False,
            "masterKeyDependency": "CRITICAL: Encrypted integration secrets require the active CYRIS_MASTER_KEY to decrypt upon restore.",
        },
    }

    manifest_path = os.path.join(backup_dir, "manifest.json")
    with open(manifest_path, "w", encoding="utf-8") as f:
        json.dump(manifest, f, indent=2)

    # Compress into tar.gz archive
    archive_path = f"{backup_dir}.tar.gz"
    print(f"  Compressing archive to {archive_path}...")
    run_command(f"tar -czf '{archive_path}' -C '{CYRIS_BACKUPS}' '{backup_id}'")
    shutil.rmtree(backup_dir)

    # Generate sha256 checksum
    h = hashlib.sha256()
    with open(archive_path, "rb") as f:
        while chunk := f.read(8192):
            h.update(chunk)
    checksum = h.hexdigest()
    with open(f"{archive_path}.sha256", "w") as f:
        f.write(f"{checksum}  {os.path.basename(archive_path)}\n")

    archive_size_mb = os.path.getsize(archive_path) / (1024 * 1024)
    print("================================================================")
    print(f"{COLOR_GREEN}✓ Backup created successfully!{COLOR_RESET}")
    print(f"  Archive:  {archive_path}")
    print(f"  Size:     {archive_size_mb:.2f} MB")
    print(f"  SHA-256:  {checksum}")
    print("================================================================")


def cmd_backup_verify(args):
    """Verify integrity of a backup archive."""
    target = args.backup
    if not target:
        # Find newest backup
        backups = [f for f in os.listdir(CYRIS_BACKUPS) if f.startswith("backup_") and f.endswith(".tar.gz")]
        if not backups:
            print(f"{COLOR_RED}Error:{COLOR_RESET} No backup archives found in {CYRIS_BACKUPS}")
            sys.exit(1)
        backups.sort(reverse=True)
        target = os.path.join(CYRIS_BACKUPS, backups[0])

    if not os.path.isabs(target):
        target = os.path.join(CYRIS_BACKUPS, target)

    print(f"Verifying backup archive: {target}")

    if not os.path.exists(target):
        print(f"{COLOR_RED}Error:{COLOR_RESET} Backup file not found: {target}")
        sys.exit(1)

    # Check sha256 checksum if .sha256 file exists
    sha_file = f"{target}.sha256"
    if os.path.exists(sha_file):
        with open(sha_file) as f:
            expected_hash = f.read().split()[0]
        h = hashlib.sha256()
        with open(target, "rb") as f:
            while chunk := f.read(8192):
                h.update(chunk)
        actual_hash = h.hexdigest()
        if actual_hash != expected_hash:
            print(f"{COLOR_RED}Checksum verification failed!{COLOR_RESET}")
            print(f"  Expected: {expected_hash}")
            print(f"  Actual:   {actual_hash}")
            sys.exit(1)
        print("  ✓ SHA-256 checksum verified.")

    # Inspect tarball contents
    tar_list = run_command(f"tar -tf '{target}'", check=False).stdout.strip().split("\n")
    has_manifest = any("manifest.json" in line for line in tar_list)
    has_db = any("database.sql" in line for line in tar_list)

    if not has_manifest:
        print(f"{COLOR_RED}Integrity failure:{COLOR_RESET} manifest.json missing from archive.")
        sys.exit(1)
    if not has_db:
        print(f"{COLOR_RED}Integrity failure:{COLOR_RESET} database.sql missing from archive.")
        sys.exit(1)

    print("  ✓ Archive contains manifest.json and database.sql.")
    print(f"{COLOR_GREEN}✓ Backup verification SUCCESSFUL!{COLOR_RESET}")


def cmd_backups(args):
    """List available backups."""
    if not os.path.exists(CYRIS_BACKUPS):
        print(f"No backups directory found at {CYRIS_BACKUPS}")
        return

    files = [f for f in os.listdir(CYRIS_BACKUPS) if f.startswith("backup_") and f.endswith(".tar.gz")]
    files.sort(reverse=True)

    print(f"{COLOR_BOLD}{'TIMESTAMP':<20} {'VERSION':<10} {'SIZE':<10} {'STATUS':<12} {'FILENAME'}{COLOR_RESET}")
    print("-" * 75)

    for f in files:
        full_path = os.path.join(CYRIS_BACKUPS, f)
        size_mb = f"{os.path.getsize(full_path) / (1024*1024):.1f} MB"
        # Parse timestamp and version from filename backup_YYYY-MM-DDTHH-MM-SS_vX.Y.Z.tar.gz
        parts = f.replace(".tar.gz", "").split("_")
        ts = parts[1] if len(parts) > 1 else "unknown"
        ver = parts[2] if len(parts) > 2 else "2.0.0"
        has_sha = os.path.exists(f"{full_path}.sha256")
        status = "VERIFIED" if has_sha else "UNVERIFIED"
        print(f"{ts:<20} {ver:<10} {size_mb:<10} {COLOR_GREEN if status == 'VERIFIED' else COLOR_YELLOW}{status:<12}{COLOR_RESET} {f}")


def cmd_restore(args):
    """Restore CYRIS from a verified backup."""
    target = args.backup
    if not target:
        print(f"{COLOR_RED}Error:{COLOR_RESET} Please specify the backup file to restore (e.g. cyrisctl restore backup_...tar.gz)")
        sys.exit(1)

    if not os.path.isabs(target):
        target = os.path.join(CYRIS_BACKUPS, target)

    if not os.path.exists(target):
        print(f"{COLOR_RED}Error:{COLOR_RESET} Backup file not found: {target}")
        sys.exit(1)

    print("================================================================")
    print(f"{COLOR_RED}  WARNING: DISASTER RECOVERY RESTORATION{COLOR_RESET}")
    print("================================================================")
    print("Restoring will OVERWRITE current database records and storage.")
    print(f"Target archive: {target}\n")

    if not getattr(args, "force", False):
        confirm = input("Are you absolutely sure you want to proceed? [y/N]: ").strip().lower()
        if confirm != "y":
            print("Restoration cancelled.")
            sys.exit(0)

    # 1. Verify backup
    print("[1/4] Verifying backup integrity...")
    run_command([sys.executable, sys.argv[0], "backup", "verify", target], check=True)

    # 2. Extract backup to temporary directory
    temp_dir = os.path.join(CYRIS_BACKUPS, f"restore_{int(time.time())}")
    os.makedirs(temp_dir, mode=0o700, exist_ok=True)
    try:
        run_command(f"tar -xzf '{target}' -C '{temp_dir}'", check=True)
        subdirs = [os.path.join(temp_dir, d) for d in os.listdir(temp_dir) if os.path.isdir(os.path.join(temp_dir, d))]
        restore_src = subdirs[0] if subdirs else temp_dir

        # 3. Stop application services
        print("[2/4] Stopping application services...")
        docker_compose_cmd("stop", "web", "worker", "api", capture=False, check=False)

        # 4. Restore PostgreSQL
        print("[3/4] Restoring PostgreSQL database...")
        db_sql = os.path.join(restore_src, "database.sql")
        if not os.path.exists(db_sql):
            raise Exception("database.sql missing from extracted backup")

        # Drop and recreate schema or restore
        docker_compose_cmd(
            "exec", "-T", "postgres",
            "psql", "-U", "cyris", "-d", "cyris", "-c", "DROP SCHEMA public CASCADE; CREATE SCHEMA public;",
            check=False
        )
        with open(db_sql, "rb") as f:
            restore_cmd = ["docker", "compose", "-f", CYRIS_COMPOSE_FILE]
            if os.path.exists(CYRIS_ENV_FILE):
                restore_cmd.extend(["--env-file", CYRIS_ENV_FILE])
            restore_cmd.extend(["exec", "-T", "postgres", "psql", "-U", "cyris", "-d", "cyris"])
            subprocess.run(restore_cmd, stdin=f, check=True)
        print("  ✓ PostgreSQL database restored.")

        # 5. Restore S3 storage
        print("[4/4] Restoring S3 storage files...")
        s3_src = os.path.join(restore_src, "s3", "cyris-storage")
        if os.path.exists(s3_src):
            minio_dst = os.path.join(CYRIS_VAR, "minio", "cyris-storage")
            if os.path.exists(minio_dst):
                shutil.rmtree(minio_dst)
            shutil.copytree(s3_src, minio_dst)
            print("  ✓ S3 object storage restored.")

        # Restart all services
        print("\nRestarting services...")
        docker_compose_cmd("up", "-d", capture=False)

        print("\n================================================================")
        print(f"{COLOR_GREEN}✓ CYRIS restored successfully from {target}!{COLOR_RESET}")
        print("================================================================")
    finally:
        if os.path.exists(temp_dir):
            shutil.rmtree(temp_dir)


