REPO_API = "https://api.github.com/repos/RandomUcet/CYRIS_v2"
APP_SERVICES = ("api", "worker", "web")
VERSION_PATTERN = r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)"


def atomic_file(path, data, mode):
    path = Path(path)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as f:
        temporary = Path(f.name)
        try:
            os.fchmod(f.fileno(), mode)
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        except BaseException:
            temporary.unlink()
            raise
    try:
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def github_get(endpoint, accept="application/vnd.github+json", token=None):
    token_file = Path(CYRIS_ETC, "github.token")
    if token is None:
        token = os.environ.get("GITHUB_TOKEN") or load_env().get("GITHUB_TOKEN")
        if not token and token_file.exists():
            token = token_file.read_text().strip()
    request = urllib.request.Request(REPO_API + endpoint, headers={"Accept": accept, "User-Agent": "cyrisctl"})
    if token:
        request.add_unredirected_header("Authorization", "Bearer " + token)
    with urllib.request.urlopen(request, timeout=30) as response:
        return response.read()


def cmd_github_login(args):
    username = input("GitHub username: ").strip()
    token = getpass.getpass("GitHub token (repository read + package read): ").strip()
    if not username or not token:
        raise ValueError("Missing GitHub credentials")
    github_get("", token=token)
    release = github_release(token=token)
    # Test credentials in an isolated Docker config first. A 403 must not
    # overwrite the root user's previously working Docker registry credentials.
    with tempfile.TemporaryDirectory(prefix="cyris-ghcr-auth-") as temp:
        isolated = dict(os.environ, DOCKER_CONFIG=temp)
        subprocess.run(["docker", "login", "ghcr.io", "--username", username, "--password-stdin"],
                       input=token, text=True, check=True, env=isolated)
        version = verify_release_registry_access(release, token=token, docker_env=isolated)
    # Commit root Docker credentials and the private-release token only on success.
    subprocess.run(["docker", "login", "ghcr.io", "--username", username, "--password-stdin"],
                   input=token, text=True, check=True)
    atomic_file(Path(CYRIS_ETC, "github.token"), token.encode(), 0o600)
    print(f"GitHub Release and all three private GHCR packages verified for v{version}.")


def github_release(version=None, token=None):
    endpoint = "/releases/latest"
    if version:
        version = version.removeprefix("v")
        if not re.fullmatch(VERSION_PATTERN, version):
            raise ValueError("Expected a stable vMAJOR.MINOR.PATCH release")
        endpoint = "/releases/tags/v" + version
    release = json.loads(github_get(endpoint, token=token))
    tag = release["tag_name"]
    if (release["draft"] or release["prerelease"] or not re.fullmatch("v" + VERSION_PATTERN, tag)
            or (version and tag != "v" + version)):
        raise ValueError("Expected a published stable release")
    return release


def release_asset(release, name, token=None):
    asset = next((a for a in release["assets"] if a["name"] == name), None)
    if not asset or not isinstance(asset["id"], int):
        raise ValueError(f"Missing release asset: {name}")
    data = github_get(f"/releases/assets/{asset['id']}", "application/octet-stream", token=token)
    if asset.get("digest") != "sha256:" + hashlib.sha256(data).hexdigest():
        raise ValueError(f"Missing or incorrect GitHub digest: {name}")
    return data


def release_settings(manifest, version):
    if manifest["version"] != version or manifest.get("breaking") or manifest.get("searchReindexRequired"):
        raise ValueError("Manifest requires a manual upgrade or does not match the requested version")
    settings = {"CYRIS_VERSION": version}
    for service in APP_SERVICES:
        image = manifest["images"][service]
        if not re.fullmatch(f"ghcr.io/randomucet/cyris-{service}@sha256:[a-f0-9]{{64}}", image):
            raise ValueError(f"Expected a digest-pinned {service} image")
        settings[f"CYRIS_{service.upper()}_IMAGE"] = image
    return settings


def verify_release_registry_access(release, token=None, docker_env=None):
    """Verify read access to each digest-pinned image without downloading its layers."""
    version = release["tag_name"].removeprefix("v")
    manifest = json.loads(release_asset(release, "release-manifest.json", token=token))
    settings = release_settings(manifest, version)
    for service in APP_SERVICES:
        image = settings[f"CYRIS_{service.upper()}_IMAGE"]
        # docker manifest is experimental on some Docker CLI versions.
        # Enable the client command for this one read-only registry probe only.
        inspect_env = dict(docker_env or os.environ, DOCKER_CLI_EXPERIMENTAL="enabled")
        result = run_command(["docker", "manifest", "inspect", image], check=False, env=inspect_env)
        if result.returncode != 0:
            raise ValueError(
                f"GHCR access check failed for {service} image of v{version}. "
                "Docker login is not proof of private package permission. "
                "Grant the GitHub service account read access to cyris-api, "
                "cyris-worker and cyris-web; use a classic PAT with read:packages "
                "and repo access to the private release. "
                "Run sudo cyrisctl github login again. "
                "The application and its data have not been modified."
            )
    return version


def cmd_github_verify(args):
    """Read-only preflight; no service restart, image pull or database mutation."""
    release = github_release()
    version = verify_release_registry_access(release)
    print(f"PASS: private GitHub Release v{version} and all three GHCR images are accessible.")


def cmd_versions(args):
    print("Installed:", get_installed_version(), flush=True)
    print("Latest published release:", github_release()["tag_name"])


def cmd_update(args):
    release = github_release(args.version)
    version = release["tag_name"][1:]
    manifest = release_asset(release, "release-manifest.json")
    settings = release_settings(json.loads(manifest), version)
    current = get_installed_version()
    if re.fullmatch(VERSION_PATTERN, current) and tuple(map(int, current.split("."))) > tuple(map(int, version.split("."))):
        raise ValueError("Use a matching backup to recover an older release")
    if current == version and not args.force and all(load_env().get(k) == v for k, v in settings.items()):
        print(f"Installed release {version} is current.")
        return
    env_path = Path(CYRIS_ENV_FILE)
    original = env_path.read_bytes()
    lines = [line for line in original.decode().splitlines() if line.partition("=")[0] not in settings]
    candidate = ("\n".join(lines + [f"{k}={v}" for k, v in settings.items()]) + "\n").encode()
    with tempfile.TemporaryDirectory(dir=env_path.parent) as directory:
        staged = Path(directory, "release.env")
        atomic_file(staged, candidate, 0o600)
        compose = ["docker", "compose", "--env-file", str(staged), "-f", CYRIS_COMPOSE_FILE]
        run_command(compose + ["config", "--quiet"])
        print(f"Downloading {release['tag_name']} before stopping services.", flush=True)
        run_command(compose + ["pull", *APP_SERVICES], capture=False)
        if not set(APP_SERVICES).issubset(running_services()):
            raise ValueError("Start the installed application before upgrading")
        check = run_command(compose + ["run", "--rm", "--no-deps", "-T", "api", "node", "dist/scripts/db-status.js", "--json"], check=False)
        status = json.loads(check.stdout[check.stdout.index("{"):])
        pending = status.get("pendingCount")
        if (type(pending) is not int or pending < 0 or not status.get("totalAvailable")
                or (check.returncode, status["status"]) != ((1, "PENDING") if pending else (0, "UP_TO_DATE"))):
            raise ValueError("Unexpected migration status. Live release preserved.")
        # Keep writers stopped from the recovery point until the new release is ready.
        try:
            docker_compose_cmd("stop", *APP_SERVICES, capture=False)
            recovery = cmd_backup(args)
            cmd_backup_verify(argparse.Namespace(backup=str(recovery)))
        except BaseException:
            docker_compose_cmd("start", *APP_SERVICES, capture=False)
            raise
        migrated = False
        try:
            if pending:
                migrated = True
                run_command(compose + ["run", "--rm", "--no-deps", "-T", "api", "node", "dist/scripts/db-migrate.js"], capture=False)
            atomic_file(env_path, candidate, 0o600)
            docker_compose_cmd("up", "-d", "--no-deps", "--wait", "--wait-timeout", "240", *APP_SERVICES, capture=False)
            docker_compose_cmd("exec", "-T", "api", "curl", "-fsS", "http://127.0.0.1:4000/health/ready")
            atomic_file(CYRIS_MANIFEST_FILE, manifest, 0o644)
        except BaseException:
            if migrated:
                print(f"Migration attempted. Recover with: sudo cyrisctl restore {recovery} && sudo cyrisctl start", file=sys.stderr)
                docker_compose_cmd("stop", *APP_SERVICES, capture=False)
            else:
                atomic_file(env_path, original, 0o600)
                docker_compose_cmd("up", "-d", "--no-deps", "--wait", *APP_SERVICES, capture=False)
            raise
    print(f"Running verified CYRIS release {version}.")


def cmd_self_update(args):
    release = github_release()
    release_settings(json.loads(release_asset(release, "release-manifest.json")), release["tag_name"][1:])
    data = release_asset(release, "cyrisctl")
    compile(data, "cyrisctl", "exec")
    atomic_file(Path(CYRIS_OPT, "bin", "cyrisctl"), data, 0o755)
    print("Installed cyrisctl from", release["tag_name"])


def cmd_scheduled_backup(args):
    target = cmd_backup(args)
    cmd_backup_verify(argparse.Namespace(backup=str(target)))
    completed = sorted(Path(CYRIS_BACKUPS).glob("backup_auto_*" + SNAP_EXT), reverse=True)
    for expired in completed[14:]:
        expired.unlink()
    print("Retained the newest 14 scheduled backups.")


def cmd_schedule(args):
    if args.backup_action == "enable":
        units = Path("/etc/systemd/system")
        atomic_file(units / "cyris-backup.service", b"""[Unit]
Description=Encrypted CYRIS snapshot
After=docker.service
[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/local/bin/cyrisctl backup scheduled
""", 0o644)
        atomic_file(units / "cyris-backup.timer", b"""[Unit]
Description=Nightly CYRIS snapshot
[Timer]
OnCalendar=*-*-* 02:30:00
[Install]
WantedBy=timers.target
""", 0o644)
        run_command(["systemctl", "daemon-reload"])
        run_command(["systemctl", "enable", "--now", "cyris-backup.timer"], capture=False)
        run_command(["systemctl", "list-timers", "cyris-backup.timer"], capture=False)
    else:
        run_command(["systemctl", "disable", "--now", "cyris-backup.timer"], capture=False)


def cmd_diagnostics(args):
    """Collect non-secret operational diagnostics for troubleshooting."""
    print("Collecting non-sensitive system diagnostics...")
    os.makedirs(CYRIS_BACKUPS, mode=0o700, exist_ok=True)
    ts = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    diag_dir = os.path.join(CYRIS_BACKUPS, f"diag_{ts}")
    os.makedirs(diag_dir, mode=0o700, exist_ok=True)

    # System info
    with open(os.path.join(diag_dir, "host_info.txt"), "w") as f:
        f.write(f"Uname: {run_command('uname -a', check=False).stdout}\n")
        f.write(f"Uptime: {run_command('uptime', check=False).stdout}\n")
        f.write(f"Memory:\n{run_command('free -m', check=False).stdout}\n")
        f.write(f"Disk:\n{run_command('df -h', check=False).stdout}\n")

    # Docker container states
    with open(os.path.join(diag_dir, "docker_ps.txt"), "w") as f:
        f.write(docker_compose_cmd("ps", "-a", check=False).stdout)

    archive_path = f"{diag_dir}.tar.gz"
    run_command(["tar", "-czf", archive_path, "-C", CYRIS_BACKUPS, f"diag_{ts}"])
    shutil.rmtree(diag_dir)

    print(f"\n{COLOR_GREEN}✓ Diagnostics bundle generated:{COLOR_RESET} {archive_path}")


# ------------------------------------------------------------------------------
# Main Entry Point & Command Routing
# ------------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(
        prog="cyrisctl",
        description="CYRIS System Operations Utility for Ubuntu Server 24.04 LTS",
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="Operational commands")

    # deploy
    p_deploy = subparsers.add_parser("deploy", help="Deploy or reconfigure CYRIS production services")
    p_deploy.set_defaults(func=cmd_deploy)

    # status
    p_status = subparsers.add_parser("status", help="Show system status and health overview")
    p_status.set_defaults(func=cmd_status)

    # doctor
    p_doctor = subparsers.add_parser("doctor", help="Run system diagnostics and readiness checks")
    p_doctor.add_argument("--full", action="store_true", help="Perform comprehensive end-to-end verification")
    p_doctor.set_defaults(func=cmd_doctor)

    # lifecycle
    p_start = subparsers.add_parser("start", help="Start CYRIS services")
    p_start.set_defaults(func=cmd_start)
    p_stop = subparsers.add_parser("stop", help="Stop CYRIS services")
    p_stop.set_defaults(func=cmd_stop)
    p_restart = subparsers.add_parser("restart", help="Restart CYRIS services")
    p_restart.set_defaults(func=cmd_restart)

    # logs
    p_logs = subparsers.add_parser("logs", help="Stream service logs")
    p_logs.add_argument("service", nargs="*", help="Service name (api, worker, web, postgres, redis, typesense, minio)")
    p_logs.set_defaults(func=cmd_logs)

    # backup
    p_backup = subparsers.add_parser("backup", help="Create a disaster recovery backup snapshot")
    p_backup_sub = p_backup.add_subparsers(dest="backup_action")
    p_backup_verify = p_backup_sub.add_parser("verify", help="Verify backup archive integrity")
    p_backup_verify.add_argument("backup", nargs="?", help="Specific backup file to verify")
    p_backup_verify.set_defaults(func=cmd_backup_verify)
    p_backup.set_defaults(func=cmd_backup)
    p_backup_sub.add_parser("scheduled", help="Run and verify a rotating daily backup").set_defaults(func=cmd_scheduled_backup)
    for action in ("enable", "disable"):
        p_backup_sub.add_parser(action, help=f"{action.title()} nightly backup timer").set_defaults(func=cmd_schedule)

    p_backups = subparsers.add_parser("backups", help="List available backup snapshots")
    p_backups.set_defaults(func=cmd_backups)

    # restore
    p_restore = subparsers.add_parser("restore", help="Restore CYRIS from a backup archive")
    p_restore.add_argument("backup", help="Path or name of backup archive to restore")
    p_restore.add_argument("--force", action="store_true", help="Bypass confirmation prompt")
    p_restore.set_defaults(func=cmd_restore)

    # update & versions
    p_update = subparsers.add_parser("update", help="Update CYRIS to target or latest release")
    p_update.add_argument("--version", help="Specific version tag to install")
    p_update.add_argument("--force", action="store_true", help="Force update even if version matches")
    p_update.set_defaults(func=cmd_update)

    p_versions = subparsers.add_parser("versions", help="Display installed and available CYRIS releases")
    p_versions.set_defaults(func=cmd_versions)

    p_self_update = subparsers.add_parser("self-update", help="Update cyrisctl CLI tool")
    p_self_update.set_defaults(func=cmd_self_update)

    login = subparsers.add_parser("github", help="Configure private GitHub Releases and GHCR access")
    github_sub = login.add_subparsers(required=True)
    github_sub.add_parser("login", help="Authenticate and verify private image access").set_defaults(func=cmd_github_login)
    github_sub.add_parser("verify", help="Read-only verification of GitHub and GHCR access").set_defaults(func=cmd_github_verify)

    # config
    p_config = subparsers.add_parser("config", help="Manage production configuration")
    p_config_sub = p_config.add_subparsers(dest="config_action")
    p_config_check = p_config_sub.add_parser("check", help="Verify configuration validity and permissions")
    p_config_check.set_defaults(func=cmd_config_check)

    # db
    p_db = subparsers.add_parser("db", help="Database migration and maintenance")
    p_db_sub = p_db.add_subparsers(dest="db_action")
    p_db_status = p_db_sub.add_parser("status", help="Check database migration status")
    p_db_status.set_defaults(func=cmd_db_status)
    p_db_migrate = p_db_sub.add_parser("migrate", help="Run database migrations")
    p_db_migrate.set_defaults(func=cmd_db_migrate)

    # admin
    p_admin = subparsers.add_parser("admin", help="User and administrator administration")
    p_admin_sub = p_admin.add_subparsers(dest="admin_action")
    p_admin_create = p_admin_sub.add_parser("create", help="Bootstrap Platform Administrator")
    p_admin_create.set_defaults(func=cmd_admin_create)

    # diagnostics
    p_diag = subparsers.add_parser("diagnostics", help="Generate non-secret diagnostics archive")
    p_diag.set_defaults(func=cmd_diagnostics)

    args = parser.parse_args()

    if not hasattr(args, "func"):
        parser.print_help()
        return
    if os.geteuid() != 0:
        parser.exit(1, "Run this production command with sudo cyrisctl.\n")
    os.umask(0o077)
    def interrupted(signum, frame):
        raise SystemExit(128 + signum)
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, interrupted)
    mutates = args.subcommand in {"deploy", "start", "stop", "restart", "restore", "update", "self-update", "github", "backup", "admin"} or getattr(args, "db_action", "") == "migrate"
    with ExitStack() as stack:
        if mutates:
            lock = stack.enter_context(open("/run/cyris-first-install.lock", "a"))
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                parser.exit(1, "Another CYRIS maintenance operation is running.\n")
        args.func(args)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, tarfile.TarError, subprocess.CalledProcessError) as error:
        sys.exit(f"CYRIS: {error}")
