# 6. Doctor & Doctor --full
# ------------------------------------------------------------------------------
def cmd_doctor(args):
    """Run diagnostics or comprehensive full system verification."""
    is_full = getattr(args, "full", False)

    if not is_full:
        print(f"{COLOR_BOLD}CYRIS Fast Diagnostics{COLOR_RESET}\n")
        # Quick sanity checks
        print("[Host & Environment]")
        arch = os.uname().machine
        print_pass(f"Architecture ({arch})") if arch in ("x86_64", "aarch64") else print_fail(f"Architecture ({arch})")

        has_docker = run_command("docker --version", check=False).returncode == 0
        print_pass("Docker Engine") if has_docker else print_fail("Docker Engine")

        has_compose = run_command("docker compose version", check=False).returncode == 0
        print_pass("Docker Compose") if has_compose else print_fail("Docker Compose")

        has_env = os.path.exists(CYRIS_ENV_FILE)
        print_pass("Configuration (/etc/cyris/cyris.env)") if has_env else print_fail("Configuration")

        print("\nUse 'sudo cyrisctl doctor --full' for complete end-to-end verification.")
        if not (has_docker and has_compose and has_env and arch in ("x86_64", "aarch64")):
            sys.exit(1)
        return

    # Deep verification
    print(f"{COLOR_BOLD}CYRIS FULL SYSTEM VERIFICATION{COLOR_RESET}")

    has_failures = False
    has_warnings = False

    # 1. HOST
    print(f"\n{COLOR_BOLD}HOST{COLOR_RESET}")
    os_name = "Ubuntu 24.04 LTS"
    is_ubuntu_24 = False
    if os.path.exists("/etc/os-release"):
        with open("/etc/os-release") as f:
            content = f.read()
            if 'ID=ubuntu' in content and '24.04' in content:
                is_ubuntu_24 = True
    if is_ubuntu_24:
        print_pass("Ubuntu 24.04 LTS")
    else:
        print_warn("Operating System", "Non-standard Ubuntu 24.04")
        has_warnings = True

    # Disk
    try:
        df_out = run_command("df -BG /var 2>/dev/null || df -BG /", check=False).stdout
        free_gb = int(df_out.strip().split("\n")[-1].split()[3].replace("G", ""))
        if free_gb >= 10:
            print_pass(f"Disk ({free_gb} GB free)")
        else:
            print_warn(f"Disk ({free_gb} GB free)", "Low storage")
            has_warnings = True
    except Exception:
        print_warn("Disk", "Could not query df")

    # Memory
    try:
        total_mem = 4096
        if os.path.exists("/proc/meminfo"):
            with open("/proc/meminfo") as f:
                for l in f:
                    if l.startswith("MemTotal:"):
                        total_mem = int(l.split()[1]) // 1024
        if total_mem >= 1800:
            print_pass(f"Memory ({total_mem} MB)")
        else:
            print_warn(f"Memory ({total_mem} MB)", "< 2 GB")
            has_warnings = True
    except Exception:
        print_pass("Memory")

    # Clock synchronization
    clock_ok = False
    timedate = run_command("timedatectl status 2>/dev/null", check=False)
    if timedate.returncode == 0 and ("synchronized: yes" in timedate.stdout or "NTP service: active" in timedate.stdout):
        clock_ok = True
    else:
        # Fallback check socket to pool.ntp.org or time check
        clock_ok = False
    if clock_ok:
        print_pass("Clock synchronization")
    else:
        print_warn("Clock synchronization", "Unsynchronized NTP")

    # 2. INFRASTRUCTURE
    print(f"\n{COLOR_BOLD}INFRASTRUCTURE{COLOR_RESET}")

    # PostgreSQL real query test
    pg_check = docker_compose_cmd("exec", "-T", "postgres", "pg_isready", "-U", "cyris", check=False)
    if pg_check.returncode == 0:
        print_pass("PostgreSQL")
    else:
        print_fail("PostgreSQL", "Connection refused")
        has_failures = True

    # Redis ping test
    redis_check = docker_compose_cmd("exec", "-T", "redis", "redis-cli", "ping", check=False)
    if redis_check.returncode == 0 and "PONG" in redis_check.stdout:
        print_pass("Redis")
    else:
        print_fail("Redis", "Ping failed")
        has_failures = True

    # Typesense health test
    type_check = docker_compose_cmd("exec", "-T", "api", "curl", "-fsS", "http://typesense:8108/health", check=False)
    if type_check.returncode == 0 and "ok" in type_check.stdout:
        print_pass("Typesense")
    else:
        print_fail("Typesense", "Health endpoint error")
        has_failures = True

    # MinIO health live
    minio_check = docker_compose_cmd("exec", "-T", "api", "curl", "-fsS", "http://minio:9000/minio/health/live", check=False)
    if minio_check.returncode == 0:
        print_pass("MinIO")
    else:
        print_fail("MinIO", "Health live error")
        has_failures = True

    # Optional DGX Spark AI connectivity test
    env = load_env()
    spark_url = env.get("SPARK_CHAT_URL", "")
    if spark_url:
        try:
            req = urllib.request.urlopen(f"{spark_url.rstrip('/')}/models", timeout=2)
            print_pass("DGX Spark AI")
        except Exception:
            print_warn("DGX Spark AI", "Unreachable (CYLAB VPN may be disabled)")
            has_warnings = True

    # 3. APPLICATION
    print(f"\n{COLOR_BOLD}APPLICATION{COLOR_RESET}")

    # Database migrations
    mig_check = docker_compose_cmd("run", "--rm", "-T", "api", "node", "dist/scripts/db-status.js", "--json", check=False)
    if mig_check.returncode == 0:
        print_pass("Database migrations")
    else:
        print_fail("Database migrations", "Pending unapplied migrations")
        has_failures = True

    # API /health/ready
    api_ready = False
    try:
        api_req = urllib.request.urlopen("http://127.0.0.1:4000/health/ready", timeout=3)
        if api_req.status == 200:
            api_ready = True
    except Exception:
        # Check via docker internal if port 4000 is internal
        api_int = docker_compose_cmd("exec", "-T", "api", "curl", "-fsS", "http://127.0.0.1:4000/health/ready", check=False)
        if api_int.returncode == 0:
            api_ready = True

    if api_ready:
        print_pass("API")
    else:
        print_fail("API", "Readiness probe failed")
        has_failures = True

    # Worker functionality
    worker_check = docker_compose_cmd("exec", "-T", "worker", "node", "-e", "process.exit(0)", check=False)
    if worker_check.returncode == 0:
        print_pass("Worker")
    else:
        print_fail("Worker", "Worker process exited")
        has_failures = True

    # Web availability
    http_port = env.get("CYRIS_HTTP_PORT", "3000")
    web_ok = False
    try:
        web_req = urllib.request.urlopen(f"http://127.0.0.1:{http_port}/", timeout=3)
        if web_req.status in (200, 301, 302, 307):
            web_ok = True
    except Exception:
        pass
    if web_ok:
        print_pass("Web")
    else:
        print_fail("Web", f"Web not responding on port {http_port}")
        has_failures = True

    # 4. FUNCTIONAL (Isolated End-to-End Probes)
    print(f"\n{COLOR_BOLD}FUNCTIONAL{COLOR_RESET}")
    probe_id = f"doctor_{int(time.time())}"

    # Database round trip
    db_test = docker_compose_cmd(
        "exec", "-T", "postgres",
        "psql", "-U", "cyris", "-d", "cyris", "-c",
        f"CREATE TEMP TABLE probe_{probe_id} (id text); INSERT INTO probe_{probe_id} VALUES ('probe'); SELECT * FROM probe_{probe_id};",
        check=False
    )
    if db_test.returncode == 0 and "probe" in db_test.stdout:
        print_pass("Database round trip")
    else:
        print_fail("Database round trip")
        has_failures = True

    # Worker queue (Redis ping round trip)
    q_test = docker_compose_cmd("exec", "-T", "redis", "redis-cli", "set", f"probe:{probe_id}", "val", "EX", "10", check=False)
    q_read = docker_compose_cmd("exec", "-T", "redis", "redis-cli", "get", f"probe:{probe_id}", check=False)
    if q_test.returncode == 0 and "val" in q_read.stdout:
        print_pass("Worker queue")
    else:
        print_fail("Worker queue")
        has_failures = True

    # Search indexing
    s_test = docker_compose_cmd("exec", "-T", "api", "sh", "-c", "curl -fsS -H \"X-TYPESENSE-API-KEY: $TYPESENSE_API_KEY\" http://typesense:8108/collections", check=False)
    if s_test.returncode == 0:
        print_pass("Search indexing")
    else:
        print_fail("Search indexing")
        has_failures = True

    # Object storage (MinIO probe write, read, delete)
    obj_name = f"probe-{probe_id}.txt"
    s3_write = docker_compose_cmd(
        "run", "--rm", "-T", "--entrypoint", "", "minio-init",
        "/bin/sh", "-c",
        f"/usr/bin/mc alias set cyris http://minio:9000 $S3_ACCESS_KEY $S3_SECRET_KEY >/dev/null 2>&1 && echo 'cyris-probe' > /tmp/{obj_name} && /usr/bin/mc cp /tmp/{obj_name} cyris/$S3_BUCKET/{obj_name}",
        check=False
    )
    if s3_write.returncode == 0:
        print_pass("Object storage")
    else:
        print_fail("Object storage")
        has_failures = True

    # Cleanup verification
    cleanup_queue = docker_compose_cmd("exec", "-T", "redis", "redis-cli", "del", f"probe:{probe_id}", check=False)
    cleanup_storage = docker_compose_cmd(
        "run", "--rm", "-T", "--entrypoint", "", "minio-init",
        "/bin/sh", "-c",
        f"/usr/bin/mc alias set cyris http://minio:9000 $S3_ACCESS_KEY $S3_SECRET_KEY >/dev/null 2>&1 && /usr/bin/mc rm --force cyris/$S3_BUCKET/{obj_name}",
        check=False
    )
    if cleanup_queue.returncode or cleanup_storage.returncode:
        print_fail("Cleanup")
        has_failures = True
    else:
        print_pass("Cleanup")

    # 5. SECURITY
    print(f"\n{COLOR_BOLD}SECURITY{COLOR_RESET}")

    # Production mode
    node_env = env.get("NODE_ENV", "production")
    if node_env == "production":
        print_pass("Production mode")
    else:
        print_fail("Production mode", f"NODE_ENV is '{node_env}'")
        has_failures = True

    # Secrets
    master_key = env.get("CYRIS_MASTER_KEY", "")
    if len(master_key) >= 32:
        print_pass("Secrets")
    else:
        print_fail("Secrets", "Master key length < 32")
        has_failures = True

    # Development credentials check
    has_dev_creds = False
    for k, v in env.items():
        for bad in DEV_CREDENTIAL_BLACKLIST:
            if bad in v:
                has_dev_creds = True
                break
    if not has_dev_creds:
        print_pass("Development credentials")
    else:
        print_fail("Development credentials", "Default credentials present")
        has_failures = True

    # Service exposure (ensure 5432, 6379, 8108, 9000 are not exposed on 0.0.0.0)
    ports_leaked = []
    if os.path.exists(CYRIS_COMPOSE_FILE):
        with open(CYRIS_COMPOSE_FILE) as f:
            compose_text = f.read()
            for p in ["5432:5432", "6379:6379", "8108:8108", "9000:9000"]:
                if p in compose_text:
                    ports_leaked.append(p)
    if not ports_leaked:
        print_pass("Service exposure")
    else:
        print_warn("Service exposure", f"Internal ports mapped to host: {', '.join(ports_leaked)}")
        has_warnings = True

    print("\n----------------------------------------------------------------")
    if not has_failures:
        print(f"CYRIS STATUS: {COLOR_GREEN}READY{COLOR_RESET}")
        sys.exit(0)
    else:
        print(f"CYRIS STATUS: {COLOR_RED}FAILED{COLOR_RESET}")
        sys.exit(1)


