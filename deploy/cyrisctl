    subparsers = parser.add_subparsers(dest="subcommand", help="Operational commands")

    # deploy
    p_deploy = subparsers.add_parser("deploy", help="Deploy or reconfigure CYRIS production services")
    p_deploy.set_defaults(func=cmd_deploy)

    # status
    p_status = subparsers.add_parser("status", help="Show system status and health overview")
    p_status.set_defaults(func=cmd_status)

    # doctor
    p_doctor = subparsers.add_parser("doctor", help="Run system diagnostics and readiness checks")
    p_doctor.add_argument("--full", action="store_true", help="Perform comprehensive end-to-end verification")
    p_doctor.set_defaults(func=cmd_doctor)

    # lifecycle
    p_start = subparsers.add_parser("start", help="Start CYRIS services")
    p_start.set_defaults(func=cmd_start)
    p_stop = subparsers.add_parser("stop", help="Stop CYRIS services")
    p_stop.set_defaults(func=cmd_stop)
    p_restart = subparsers.add_parser("restart", help="Restart CYRIS services")
    p_restart.set_defaults(func=cmd_restart)

    # logs
    p_logs = subparsers.add_parser("logs", help="Stream service logs")
    p_logs.add_argument("service", nargs="*", help="Service name (api, worker, web, postgres, redis, typesense, minio)")
    p_logs.set_defaults(func=cmd_logs)

    # backup
    p_backup = subparsers.add_parser("backup", help="Create a disaster recovery backup snapshot")
    p_backup_sub = p_backup.add_subparsers(dest="backup_action")
    p_backup_verify = p_backup_sub.add_parser("verify", help="Verify backup archive integrity")
    p_backup_verify.add_argument("backup", nargs="?", help="Specific backup file to verify")
    p_backup_verify.set_defaults(func=cmd_backup_verify)
    p_backup.set_defaults(func=cmd_backup)

    p_backups = subparsers.add_parser("backups", help="List available backup snapshots")
    p_backups.set_defaults(func=cmd_backups)

    # restore
    p_restore = subparsers.add_parser("restore", help="Restore CYRIS from a backup archive")
    p_restore.add_argument("backup", help="Path or name of backup archive to restore")
    p_restore.add_argument("--force", action="store_true", help="Bypass confirmation prompt")
    p_restore.set_defaults(func=cmd_restore)

    # update & versions
    p_update = subparsers.add_parser("update", help="Update CYRIS to target or latest release")
    p_update.add_argument("--version", help="Specific version tag to install")
    p_update.add_argument("--force", action="store_true", help="Force update even if version matches")
    p_update.set_defaults(func=cmd_update)

    p_versions = subparsers.add_parser("versions", help="Display installed and available CYRIS releases")
    p_versions.set_defaults(func=cmd_versions)

    p_self_update = subparsers.add_parser("self-update", help="Update cyrisctl CLI tool")
    p_self_update.set_defaults(func=cmd_self_update)

    # config
    p_config = subparsers.add_parser("config", help="Manage production configuration")
    p_config_sub = p_config.add_subparsers(dest="config_action")
    p_config_check = p_config_sub.add_parser("check", help="Verify configuration validity and permissions")
    p_config_check.set_defaults(func=cmd_config_check)

    # db
    p_db = subparsers.add_parser("db", help="Database migration and maintenance")
    p_db_sub = p_db.add_subparsers(dest="db_action")
    p_db_status = p_db_sub.add_parser("status", help="Check database migration status")
    p_db_status.set_defaults(func=cmd_db_status)
    p_db_migrate = p_db_sub.add_parser("migrate", help="Run database migrations")
    p_db_migrate.set_defaults(func=cmd_db_migrate)

    # admin
    p_admin = subparsers.add_parser("admin", help="User and administrator administration")
    p_admin_sub = p_admin.add_subparsers(dest="admin_action")
    p_admin_create = p_admin_sub.add_parser("create", help="Bootstrap Platform Administrator")
    p_admin_create.set_defaults(func=cmd_admin_create)

    # diagnostics
    p_diag = subparsers.add_parser("diagnostics", help="Generate non-secret diagnostics archive")
    p_diag.set_defaults(func=cmd_diagnostics)

    args = parser.parse_args()

    # Route sub-subcommands if called
    if args.subcommand == "backup" and getattr(args, "backup_action", None) == "verify":
        cmd_backup_verify(args)
    elif args.subcommand == "config" and getattr(args, "config_action", None) == "check":
        cmd_config_check(args)
    elif args.subcommand == "db" and getattr(args, "db_action", None) == "status":
        cmd_db_status(args)
    elif args.subcommand == "db" and getattr(args, "db_action", None) == "migrate":
        cmd_db_migrate(args)
    elif args.subcommand == "admin" and getattr(args, "admin_action", None) == "create":
        cmd_admin_create(args)
    elif hasattr(args, "func"):
        args.func(args)
    else:
        parser.print_help()
        sys.exit(0)


if __name__ == "__main__":
    main()
