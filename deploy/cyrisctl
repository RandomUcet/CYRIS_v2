def cmd_admin_create(args):
    """Bootstrap the initial Platform Administrator."""
    cmd = ["docker", "compose", "-f", CYRIS_COMPOSE_FILE]
    if os.path.exists(CYRIS_ENV_FILE):
        cmd.extend(["--env-file", CYRIS_ENV_FILE])
    cmd.extend(["run", "--rm"])
    for env_var in ["CYRIS_ADMIN_EMAIL", "CYRIS_ADMIN_NAME", "CYRIS_ADMIN_PASSWORD"]:
        if os.environ.get(env_var):
            cmd.extend(["-e", env_var])
    if not sys.stdin.isatty():
        cmd.extend(["-T", "api", "node", "dist/scripts/create-admin.js"])
    else:
        cmd.extend(["api", "node", "dist/scripts/create-admin.js"])
    res = subprocess.run(cmd)
    sys.exit(res.returncode)


