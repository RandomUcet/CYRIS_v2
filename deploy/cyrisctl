# 5. System Status
# ------------------------------------------------------------------------------
def cmd_status(args):
    """Display clean operational status matching target specification."""
    res = docker_compose_cmd("ps", "--format", "json", check=False)
    service_states = {}
    if res.returncode == 0 and res.stdout:
        for line in res.stdout.strip().split("\n"):
            if not line:
                continue
            try:
                c = json.loads(line)
                srv = c.get("Service", "")
                st = c.get("State", "")
                hlth = c.get("Health", "")
                service_states[srv] = (st, hlth)
            except Exception:
                pass

    def check_service(name):
        st, hlth = service_states.get(name, ("down", "unknown"))
        if st == "running":
            if hlth in ("healthy", ""):
                return "PASS"
            elif hlth == "starting":
                return "STARTING"
            else:
                return "DEGRADED"
        return "STOPPED"

    # Check host load/health
    host_ok = "PASS"
    try:
        df_out = run_command("df -BG /var 2>/dev/null || df -BG /", check=False).stdout
        free_gb = int(df_out.strip().split("\n")[-1].split()[3].replace("G", ""))
        if free_gb < 2:
            host_ok = "DEGRADED"
    except Exception:
        pass

    pg_status = check_service("postgres")
    redis_status = check_service("redis")
    type_status = check_service("typesense")
    minio_status = check_service("minio")
    api_status = check_service("api")
    worker_status = check_service("worker")
    web_status = check_service("web")

    version = get_installed_version()
    env = load_env()
    env_name = env.get("NODE_ENV", "production")

    print(f"{COLOR_BOLD}CYRIS System Status{COLOR_RESET}")
    print(f"Host         {COLOR_GREEN if host_ok == 'PASS' else COLOR_YELLOW}{host_ok}{COLOR_RESET}")
    print(f"PostgreSQL   {COLOR_GREEN if pg_status == 'PASS' else COLOR_RED}{pg_status}{COLOR_RESET}")
    print(f"Redis        {COLOR_GREEN if redis_status == 'PASS' else COLOR_RED}{redis_status}{COLOR_RESET}")
    print(f"Typesense    {COLOR_GREEN if type_status == 'PASS' else COLOR_RED}{type_status}{COLOR_RESET}")
    print(f"MinIO        {COLOR_GREEN if minio_status == 'PASS' else COLOR_RED}{minio_status}{COLOR_RESET}")
    print(f"API          {COLOR_GREEN if api_status == 'PASS' else COLOR_RED}{api_status}{COLOR_RESET}")
    print(f"Worker       {COLOR_GREEN if worker_status == 'PASS' else COLOR_RED}{worker_status}{COLOR_RESET}")
    print(f"Web          {COLOR_GREEN if web_status == 'PASS' else COLOR_RED}{web_status}{COLOR_RESET}")
    print(f"Version      {version}")
    print(f"Environment  {env_name}")

    all_pass = all(s == "PASS" for s in [host_ok, pg_status, redis_status, type_status, minio_status, api_status, worker_status, web_status])
    if all_pass:
        print(f"\n{COLOR_GREEN}CYRIS is operational.{COLOR_RESET}")
        sys.exit(0)
    else:
        print(f"\n{COLOR_YELLOW}CYRIS is degraded or stopped.{COLOR_RESET}")
        sys.exit(1)


