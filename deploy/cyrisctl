# ------------------------------------------------------------------------------
def run_command(cmd, check=True, capture=True, env=None, text=True):
    """Run a shell command safely using subprocess."""
    try:
        res = subprocess.run(
            cmd,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.PIPE if capture else None,
            check=check,
            shell=isinstance(cmd, str),
            env=env or os.environ.copy(),
            text=text,
        )
        return res
    except subprocess.CalledProcessError as e:
        if check:
            raise e
        return e


def load_env(path: str = CYRIS_ENV_FILE) -> dict:
    """Parse key-value pairs from an env file, ignoring comments and blanks."""
    env = {}
    if not os.path.exists(path):
        return env
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" in line:
                k, v = line.split("=", 1)
                k = k.strip()
                v = v.strip().strip("'\"")
                env[k] = v
    return env


def get_installed_version() -> str:
    """Retrieve installed version from release manifest or environment."""
    if os.path.exists(CYRIS_MANIFEST_FILE):
        try:
            with open(CYRIS_MANIFEST_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                return data.get("version", "unknown")
        except Exception:
            pass
    env = load_env()
    return env.get("CYRIS_VERSION", "0.1.0")


def docker_compose_cmd(*args, capture=True, check=True):
    """Execute docker compose command with production compose file and env file."""
    if not os.path.exists(CYRIS_COMPOSE_FILE):
        print(f"{COLOR_RED}Error:{COLOR_RESET} Production runtime definition not found at {CYRIS_COMPOSE_FILE}")
        sys.exit(1)

    cmd = ["docker", "compose", "-f", CYRIS_COMPOSE_FILE]
    if os.path.exists(CYRIS_ENV_FILE):
        cmd.extend(["--env-file", CYRIS_ENV_FILE])
    cmd.extend(args)
    return run_command(cmd, check=check, capture=capture)


