def cmd_update(args):
    """Perform verified upgrade to latest or target version."""
    print("================================================================")
    print("  CYRIS v2 — Release Update Workflow")
    print("================================================================\n")

    current_ver = get_installed_version()
    raw_target = getattr(args, "version", None)
    target_ver = raw_target.lstrip("v") if raw_target else None

    if not target_ver:
        # Determine latest release from GitHub or prompt
        print("[1/7] Discovering latest release...")
        url = "https://api.github.com/repos/RandomUcet/CYRIS_v2/releases/latest"
        try:
            req = urllib.request.Request(url, headers=get_github_headers())
            with urllib.request.urlopen(req, timeout=5) as res:
                rel = json.loads(res.read().decode())
                target_ver = rel.get("tag_name", "").lstrip("v")
        except Exception:
            target_ver = current_ver

    print(f"Current version:  {current_ver}")
    print(f"Target version:   {target_ver}")

    if current_ver == target_ver and not getattr(args, "force", False):
        print("\nCYRIS is already on the target version. Use --force to reinstall.")
        sys.exit(0)

    # 1. Create verified pre-update backup
    print("\n[2/7] Creating mandatory pre-update backup...")
    try:
        run_command([sys.executable, sys.argv[0], "backup"], check=True)
    except Exception as e:
        print(f"{COLOR_RED}Update aborted:{COLOR_RESET} Pre-update backup failed: {e}")
        sys.exit(1)

    # 2. Pull new container images
    print("\n[3/7] Pulling target release container images...")
    os.environ["CYRIS_VERSION"] = target_ver
    os.environ["CYRIS_API_IMAGE"] = f"ghcr.io/randomucet/cyris-api:{target_ver}"
    os.environ["CYRIS_WORKER_IMAGE"] = f"ghcr.io/randomucet/cyris-worker:{target_ver}"
    os.environ["CYRIS_WEB_IMAGE"] = f"ghcr.io/randomucet/cyris-web:{target_ver}"

    res = docker_compose_cmd("pull", check=False)
    if res.returncode != 0:
        print(f"{COLOR_RED}Error:{COLOR_RESET} Could not pull target container images for version {target_ver}.")
        sys.exit(1)

    # 3. Stop application services before migration
    print("\n[4/7] Stopping application workers...")
    docker_compose_cmd("stop", "web", "worker", "api", capture=False, check=False)

    # 4. Perform database migrations
    print("\n[5/7] Applying target database migrations...")
    mig_res = docker_compose_cmd("run", "--rm", "-T", "api", "node", "dist/scripts/db-migrate.js", capture=False, check=False)
    if mig_res.returncode != 0:
        print("\n================================================================")
        print(f"{COLOR_RED}CYRIS update failed.{COLOR_RESET}")
        print("Application rollback alone is unsafe because database migrations were attempted.")
        print("Recommended recovery: sudo cyrisctl restore <latest-pre-update-backup>")
        print("================================================================\n")
        sys.exit(1)

    # 5. Start updated services
    print("\n[6/7] Starting updated release services...")
    docker_compose_cmd("up", "-d", capture=False)

    # Update persistent state
    update_env_version(target_ver)
    update_manifest_version(target_ver)

    # 6. Post-update verification
    print("\n[7/7] Running post-update smoke tests...")
    time.sleep(5)
    doctor_res = run_command([sys.executable, sys.argv[0], "doctor", "--full"], check=False)

    if doctor_res.returncode == 0:
        print(f"\n{COLOR_GREEN}✓ Update to CYRIS {target_ver} completed successfully!{COLOR_RESET}")
    else:
        print(f"\n{COLOR_YELLOW}Update completed, but some post-update checks warned. Run 'cyrisctl doctor --full'.{COLOR_RESET}")


