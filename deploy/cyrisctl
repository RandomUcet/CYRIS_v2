# 1. Config Check
# ------------------------------------------------------------------------------
def cmd_config_check(args):
    """Validate /etc/cyris/cyris.env for completeness, permissions, and security."""
    print("================================================================")
    print("  CYRIS Production Configuration Verification")
    print("================================================================\n")

    errors = []
    warnings = []

    if not os.path.exists(CYRIS_ENV_FILE):
        print(f"{COLOR_RED}[FAIL]{COLOR_RESET} Configuration file missing: {CYRIS_ENV_FILE}")
        print("Run 'sudo ./deploy/install.sh' to initialize production configuration.")
        sys.exit(1)

    # Check file permissions (on Unix, should be 0600 or readable only by owner)
    try:
        st = os.stat(CYRIS_ENV_FILE)
        file_mode = oct(st.st_mode)[-3:]
        if file_mode not in ("600", "400", "700"):
            warnings.append(f"File permissions for {CYRIS_ENV_FILE} are {file_mode} (recommend 0600).")
    except Exception as e:
        warnings.append(f"Could not stat {CYRIS_ENV_FILE}: {e}")

    env = load_env(CYRIS_ENV_FILE)

    required_keys = [
        "CYRIS_MASTER_KEY",
        "POSTGRES_PASSWORD",
        "TYPESENSE_API_KEY",
        "S3_SECRET_KEY",
        "DATABASE_URL",
        "REDIS_URL",
        "TYPESENSE_HOST",
        "S3_ENDPOINT",
        "PUBLIC_WEB_URL",
    ]

    for k in required_keys:
        val = env.get(k)
        if not val:
            errors.append(f"Missing required configuration key: {k}")
        else:
            # Check for blacklisted default development credentials
            for bad in DEV_CREDENTIAL_BLACKLIST:
                if bad in val:
                    errors.append(f"Insecure credential in key '{k}': matches development default '{bad}'")

    master_key = env.get("CYRIS_MASTER_KEY", "")
    if len(master_key) < 32:
        errors.append(f"CYRIS_MASTER_KEY must be at least 32 characters long for cryptographic envelope encryption (length: {len(master_key)}).")

    node_env = env.get("NODE_ENV", "production")
    if node_env != "production":
        warnings.append(f"NODE_ENV is set to '{node_env}'. Production systems should use 'production'.")

    # Output results
    for w in warnings:
        print_warn(w)
    for e in errors:
        print_fail(e)

    if errors:
        print(f"\n{COLOR_RED}[FAILED]{COLOR_RESET} Configuration check failed with {len(errors)} error(s).")
        sys.exit(1)
    else:
        print(f"{COLOR_GREEN}[PASS]{COLOR_RESET} Configuration at {CYRIS_ENV_FILE} is valid and secure.")
        sys.exit(0)


