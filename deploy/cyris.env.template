# ==============================================================================
# CYRIS v2 — Production Configuration Template
# Location: /etc/cyris/cyris.env
# Permissions: 0600 (chmod 600 /etc/cyris/cyris.env)
# Owner: root:root
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
CYRIS_VERSION=2.0.0
CYRIS_HTTP_PORT=3000

# Base URL used by browser users to access CYRIS (IP address or domain)
# Example LAN: http://192.168.1.100:3000
# Example Domain: https://cyris.internal
PUBLIC_WEB_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Cryptographic Security Key
# ------------------------------------------------------------------------------
# CRITICAL: 256-bit AES cryptographic master key (at least 32 characters or 64 hex chars)
# Used for envelope encryption of integration credentials, secrets, and auth cookies.
# DO NOT LOSE THIS KEY: Without it, encrypted records and integrations cannot be decrypted!
# This is automatically generated by deploy/install.sh.
CYRIS_MASTER_KEY=GENERATE_ME_32_CHARACTERS_MINIMUM

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=cyris
POSTGRES_USER=cyris
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_POSTGRES_PASSWORD
# Internal Docker connection URL used by API and Worker
DATABASE_URL=postgresql://cyris:${POSTGRES_PASSWORD}@postgres:5432/cyris

# ------------------------------------------------------------------------------
# 4. Redis (BullMQ, Queue Engine & Transient State)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 5. Typesense Search Engine
# ------------------------------------------------------------------------------
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=GENERATE_STRONG_RANDOM_TYPESENSE_KEY

# ------------------------------------------------------------------------------
# 6. S3 Object Storage / MinIO (Silo)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=cyris-storage
S3_AUDIT_BUCKET=cyris-audit
S3_ACCESS_KEY=cyris_storage_admin
S3_SECRET_KEY=GENERATE_STRONG_RANDOM_S3_SECRET_KEY

# ------------------------------------------------------------------------------
# 7. Mail & Notifications (SMTP)
# ------------------------------------------------------------------------------
# In production, configure your organizational SMTP relay.
# Default points to local or internal SMTP daemon.
SMTP_HOST=localhost
SMTP_PORT=25

# ------------------------------------------------------------------------------
# 8. External AI Integration (DGX Spark) — OPTIONAL
# ------------------------------------------------------------------------------
# Note: Production will NOT fail if Spark is temporarily unreachable (e.g. CYLAB VPN offline).
SPARK_CHAT_URL=http://10.15.69.2:8000/v1
SPARK_EMBED_URL=http://10.15.69.2:8001/v1
