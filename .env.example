# CYRIS local development environment
# Copy to .env for local development. These are placeholders only.

POSTGRES_DB=cyris
POSTGRES_USER=cyris
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://cyris:change-me-local-only@localhost:5432/cyris

REDIS_URL=redis://localhost:6379
# Shared inference slots across API replicas. At 2 or more, one is reserved for EXCON.
CYRIS_AI_MAX_CONCURRENT=2

TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=change-me-local-typesense-key

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cyris-storage
S3_ACCESS_KEY=change-me-local-minio-access
S3_SECRET_KEY=change-me-local-minio-secret

SMTP_HOST=localhost
SMTP_PORT=1025

# Replace with a generated 64-character hex key outside local development.
CYRIS_MASTER_KEY=replace-with-64-character-hex-key

# Internal API URL for local web reverse proxy
API_INTERNAL_URL=http://localhost:4000

