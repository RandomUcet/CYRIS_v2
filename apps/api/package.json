{
  "name": "@cyris/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "db:status": "nest build && node dist/scripts/db-status.js",
    "db:migrate": "nest build && node dist/scripts/db-migrate.js",
    "admin:create": "nest build && node dist/scripts/create-admin.js",
    "admin:password": "nest build && node dist/scripts/admin-password.js",
    "search:setup": "nest build && node dist/scripts/search-setup.js",
    "search:reindex": "nest build && node dist/scripts/search-reindex.js",
    "verify:step6": "nest build && node dist/scripts/verify-step6.js",
    "verify:step8": "nest build && node dist/scripts/verify-step8.js",
    "verify:phase2-step1": "nest build && node dist/scripts/verify-phase2-step1.js",
    "verify:phase2-step2": "nest build && node dist/scripts/verify-phase2-step2.js",
    "verify:phase2-step3": "nest build && node dist/scripts/verify-phase2-step3.js",
    "verify:phase2-step4": "nest build && node dist/scripts/verify-phase2-step4.js",
    "verify:phase2-step5": "nest build && node dist/scripts/verify-phase2-step5.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@cyris/config": "workspace:*",
    "@cyris/contracts": "workspace:*",
    "@cyris/db": "workspace:*",
    "@cyris/shared": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/multipart": "^8.3.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "argon2": "^0.45.1",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.38.4",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.2",
    "jose": "^6.2.12",
    "ldapts": "^9.2.0",
    "nodemailer": "^6.9.16",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typesense": "^1.8.2",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.7.3"
  }
}
